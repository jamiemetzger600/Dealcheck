# CLI access for Cloudflare (Wrangler) — copy to .env.cli and fill in.
# Used so scripts/agents can run: source .env.cli && wrangler pages ...
# Get Account ID: Cloudflare Dashboard → any product → right sidebar.
# Create token: My Profile → API Tokens → Create Token → "Edit Cloudflare Workers" template, add "Account - Cloudflare Pages - Edit".

CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here
