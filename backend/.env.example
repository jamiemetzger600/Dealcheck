# Dealcheck Backend API — Environment Variables
# Copy this file to .env for local development.
# For production, set these in the Koyeb environment variables dashboard.
# Generate JWT_SECRET with: openssl rand -base64 32

# Server
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# Database
# Local: postgresql://user:password@localhost:5432/dealcheck
# Production: use DATABASE_URL from Koyeb PostgreSQL dashboard
DATABASE_URL=postgresql://user:password@localhost:5432/dealcheck

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Stripe — get from https://dashboard.stripe.com/apikeys (test keys for dev, live for production)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email (for notifications) — Gmail: use App Password https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Web App URL (for CORS and redirects)
# Local: http://localhost:3000 — Production: your Cloudflare Pages URL (e.g. https://your-app.pages.dev)
WEB_APP_URL=http://localhost:3000
