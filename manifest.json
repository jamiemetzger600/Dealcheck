{
  "manifest_version": 3,
  "name": "Max Price Deal Analyzer",
  "version": "1.3.0",
  "description": "Calculates Max Allowable Purchase Price based on DSCR and EBITDA/SDE.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "Toggle Deal Analyzer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": ["jspdf.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
