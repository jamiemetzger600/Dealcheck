{
  "manifest_version": 3,
  "name": "Max Price Deal Analyzer",
  "version": "3.0.6",
  "description": "Complete deal acquisition platform: Aggregate deals from 10+ sources, filter with AI-powered buy box, analyze with scenario calculator, and track through due diligence. Data → Information → Knowledge → Insight → Wisdom.",
  "permissions": ["storage", "activeTab", "tabs", "alarms", "notifications", "downloads", "identity"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle Deal Analyzer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": ["version.js", "i18n.js", "jspdf.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "version.js",
        "deals-dashboard.html",
        "deals-dashboard.js",
        "scrapers/rss-parser.js",
        "utils/storage-manager.js",
        "utils/custom-source-manager.js",
        "icons/venmo-qr.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "oauth2": {
    "client_id": "452873396260-ubsei9au3n9toenpkflc00h426c0le4f.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/spreadsheets.readonly"]
  }
}
