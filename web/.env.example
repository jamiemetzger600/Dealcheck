# Vettr Web App — Environment Variables
# Copy this file to .env and fill in values for local development.
# For production, set these as environment variables in Cloudflare Pages.

# URL of the deployed backend API including /api path (no trailing slash after /api)
# Local dev: open the UI at http://localhost:5173 (not the API port). Vite proxies /api to the backend.
# Default proxy target is :3001. If the API runs on another port (e.g. PORT=3002), set:
# VITE_API_PROXY=http://localhost:3002
# Local dev: omit to use Vite proxy (frontend :5173 -> backend :3001), or set http://localhost:3001/api
# Production: https://your-koyeb-app.koyeb.app/api
# VITE_API_URL=http://localhost:3001/api

# Chrome extension ID so the logged-in web app can push the session to the extension (no user token paste).
# Production: Chrome Web Store extension ID. Local dev: ID from chrome://extensions (Developer mode) for your unpacked build.
# VITE_EXTENSION_ID=abcdefghijklmnopqrstuvwxyz123456
