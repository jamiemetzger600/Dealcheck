# PWA: never cache the worker or shell. Stale sw.js is why iOS home-screen
# apps keep serving an old Cloudflare Pages build until the app is killed.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: no-cache

# Ensure version.json is never cached so PWA update check sees new deployments
/version.json
  Cache-Control: no-store
